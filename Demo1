  current_day: 22, // اليوم الحالي المفترض
  is_danger: false
};

function renderCalendar() {
  const grid = document.getElementById('monthlyCalendarGrid');
  if(!grid) return;
  grid.innerHTML = '';
  
  // رسم 30 يوم من الشهر
  for(let i = 1; i <= 30; i++) {
    const isRecorded = appData.recorded_days.includes(i);
    const isToday = (i === appData.current_day);
    
    const dayCell = document.createElement('div');
    dayCell.className = `cal-day ${isRecorded ? 'recorded' : ''} ${isToday && !isRecorded ? 'today' : ''}`;
    dayCell.innerHTML = `
      <span>${i}</span>
      <div>${isRecorded ? '✅' : ''}</div>
    `;
    grid.appendChild(dayCell);
  }
}

